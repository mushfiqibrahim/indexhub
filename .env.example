# Service account JSON, single line (add its email as Owner in Search Console)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Max Indexing API publishes per UTC-day per service account (Google default: 200)
GOOGLE_DAILY_QUOTA=200
# IndexNow key; host https://yourdomain/<key>.txt containing the key
INDEXNOW_KEY=
# Shared secret required in the x-api-key header of API calls
API_KEY=
